#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "AlienwarePowerScript.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Alienware Power Script\0"
            VALUE "FileDescription",  "Alienware Power Script by Stylianos Angelidis\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "AlienwarePowerScript\0"
            VALUE "OriginalFilename", "AlienwarePowerScript.exe\0"
            VALUE "ProductName",      "Alienware Power Script\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
